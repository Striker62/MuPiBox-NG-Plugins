{
  "apiVersion": "1",
  "id": "community.fotospass",
  "name": "FotoSpaß",
  "description": "FotoSpaß mit bildbasierten Kategorien und zusätzlichen PNG-Accessoires aus dem eigenen SMB-Ordner.",
  "author": "Striker62",
  "version": "0.5.3",
  "runtime": "web",
  "entry": "index.html",
  "permissions": [
    "camera",
    "photo-save",
    "shared-assets"
  ],
  "display": {
    "orientation": "landscape",
    "minWidth": 800,
    "minHeight": 480
  },
  "sharedDirectories": [
    "accessoires"
  ]
}
