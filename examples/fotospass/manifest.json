{
  "apiVersion": "1",
  "id": "community.fotospass",
  "name": "FotoSpaß",
  "description": "FotoSpaß mit bildbasierten Kategorien und zusätzlichen PNG-Accessoires aus dem eigenen SMB-Ordner.",
  "author": "Striker62",
  "version": "1.1.0-beta.1",
  "runtime": "web",
  "entry": "index.html",
  "permissions": [
    "camera",
    "photo-save",
    "shared-assets"
  ],
  "category": "creative",
  "display": {
    "orientation": "landscape",
    "minWidth": 800,
    "minHeight": 480,
    "showBackButton": false
  },
  "sharedDirectories": [
    "accessoires"
  ],
  "cover": "cover.jpg",
  "icon": "icon.png"
}
