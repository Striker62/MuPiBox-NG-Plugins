{
  "apiVersion": "1",
  "id": "community.mupi-homeassistant",
  "name": "MuPi Home Assistant",
  "description": "Kinderfreundliche Home-Assistant-Steuerung mit ausschließlich hostseitig freigegebenen Entitäten.",
  "author": "MuPiBox Community",
  "version": "0.1.1",
  "runtime": "web",
  "entry": "index.html",
  "icon": "icon.svg",
  "cover": "cover.png",
  "permissions": [
    "controller",
    "homeassistant"
  ],
  "category": "tools",
  "display": {
    "orientation": "landscape",
    "minWidth": 800,
    "minHeight": 480,
    "showBackButton": false,
    "showSystemInfo": false,
    "fullScreen": true,
    "background": "app"
  }
}
