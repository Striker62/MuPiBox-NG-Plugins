{
  "apiVersion": "1",
  "id": "community.mupi-rhythm",
  "name": "MuPis Rhythm Game",
  "description": "Rhythmusspiel mit vier Touch-Spuren, Controller, eigenen Synthesizer-Melodien und Punktewertung.",
  "author": "MuPiBox Community",
  "version": "0.1.0",
  "runtime": "web",
  "entry": "index.html",
  "icon": "icon.svg",
  "cover": "cover.png",
  "permissions": [
    "storage",
    "controller",
    "audio"
  ],
  "category": "games",
  "display": {
    "orientation": "landscape",
    "minWidth": 800,
    "minHeight": 480,
    "showBackButton": false,
    "showSystemInfo": false,
    "fullScreen": true,
    "background": "app"
  }
}
