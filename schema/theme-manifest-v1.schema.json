{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "1"
    },
    "author": {
      "maxLength": 100,
      "type": "string"
    },
    "description": {
      "maxLength": 500,
      "type": "string"
    },
    "extends": {
      "enum": [
        "arcade-8bit",
        "ark-storybook",
        "block-world",
        "classic",
        "dino",
        "dreamy-pastel",
        "fairy-garden",
        "football",
        "kawaii-pop",
        "lcars",
        "magic",
        "modern-dark",
        "moonwalk",
        "mupi-kids",
        "neon-arcade",
        "neon-grid",
        "neon-grid-red",
        "night-guardian",
        "ocean",
        "pulse",
        "rainbow",
        "space",
        "vinyl",
        "web-hero"
      ]
    },
    "id": {
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$",
      "type": "string"
    },
    "kind": {
      "const": "theme"
    },
    "license": {
      "maxLength": 100,
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "preview": {
      "pattern": "^assets/[a-zA-Z0-9_/-]+\\.(?:png|jpg|jpeg|webp)$",
      "type": "string"
    },
    "theme": {
      "const": "theme.json"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "id",
    "name",
    "version",
    "extends",
    "theme"
  ],
  "title": "MuPiBox-NG .mupitheme manifest",
  "type": "object"
}
