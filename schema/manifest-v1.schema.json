{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splitti/MuPiBox-NG-Plugins/blob/main/schema/manifest-v1.schema.json",
  "title": "MuPiBox-NG plugin manifest (developer preview v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "name",
    "version",
    "runtime",
    "entry",
    "permissions"
  ],
  "properties": {
    "apiVersion": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "minLength": 5,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "runtime": {
      "enum": [
        "web",
        "qtquick-scene"
      ]
    },
    "entry": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*\\.(?:html|json)$"
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*\\.(?:png|svg)$"
    },
    "cover": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*\\.(?:png|jpg|jpeg|webp)$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "author": {
      "type": "string",
      "maxLength": 100
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "storage",
          "controller",
          "audio",
          "camera",
          "photo-save",
          "shared-assets",
          "network",
          "links",
          "homeassistant",
          "device-status",
          "playback",
          "playback-control"
        ]
      },
      "maxItems": 12
    },
    "networkHosts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]*\\.[a-z]{2,}$",
        "maxLength": 253
      },
      "maxItems": 20
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orientation": {
          "enum": [
            "landscape",
            "portrait",
            "any"
          ]
        },
        "minWidth": {
          "type": "integer",
          "minimum": 320,
          "maximum": 4096
        },
        "minHeight": {
          "type": "integer",
          "minimum": 240,
          "maximum": 4096
        },
        "showBackButton": {
          "type": "boolean"
        },
        "showSystemInfo": {
          "type": "boolean"
        },
        "fullScreen": {
          "type": "boolean"
        },
        "background": {
          "type": "string",
          "enum": [
            "system",
            "app"
          ]
        }
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "games",
        "creative",
        "learning",
        "tools",
        "other"
      ]
    },
    "galleryDirectories": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^photos(?:/[A-Za-z0-9_-]+){0,5}$"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "sharedDirectories": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+){0,5}$"
      }
    },
    "adminSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label",
              "type",
              "default"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9_]{0,39}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "help": {
                "type": "string",
                "maxLength": 300
              },
              "group": {
                "type": "string",
                "maxLength": 80
              },
              "type": {
                "enum": [
                  "boolean",
                  "string",
                  "integer",
                  "select"
                ]
              },
              "default": {
                "type": [
                  "boolean",
                  "string",
                  "integer"
                ],
                "maxLength": 200
              },
              "minLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              },
              "min": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "max": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "label"
                  ],
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "boolean"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "default": {
                      "type": "boolean"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "string"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "default": {
                      "type": "string"
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "min"
                        ]
                      },
                      {
                        "required": [
                          "max"
                        ]
                      },
                      {
                        "required": [
                          "options"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "integer"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "default": {
                      "type": "integer"
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "minLength"
                        ]
                      },
                      {
                        "required": [
                          "maxLength"
                        ]
                      },
                      {
                        "required": [
                          "options"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "select"
                    }
                  }
                },
                "then": {
                  "required": [
                    "options"
                  ],
                  "properties": {
                    "default": {
                      "type": "string"
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "min"
                        ]
                      },
                      {
                        "required": [
                          "max"
                        ]
                      },
                      {
                        "required": [
                          "minLength"
                        ]
                      },
                      {
                        "required": [
                          "maxLength"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "capabilities"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "pattern": "^admin/[a-zA-Z0-9_./-]+\\.html$"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "settings.read",
              "settings.write",
              "files.list",
              "files.read",
              "files.write",
              "files.trash"
            ]
          }
        },
        "directories": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+){0,5}$"
          }
        }
      }
    },
    "permissionReasons": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "maxProperties": 12
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "permissions": {
            "contains": {
              "const": "network"
            }
          }
        },
        "required": [
          "permissions"
        ]
      },
      "then": {
        "required": [
          "networkHosts"
        ]
      },
      "else": {
        "not": {
          "required": [
            "networkHosts"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "galleryDirectories"
        ]
      },
      "then": {
        "properties": {
          "permissions": {
            "contains": {
              "const": "photo-save"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "sharedDirectories"
        ]
      },
      "then": {
        "properties": {
          "permissions": {
            "contains": {
              "const": "shared-assets"
            }
          }
        }
      }
    }
  ]
}
